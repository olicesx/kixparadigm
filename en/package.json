{
  "name": "kixparadigm-en",
  "version": "1.3.1",
  "description": "kixparadigm-en — English edition of the kix paradigm preset for DeepSeek Harness: resident cognition layer (EN) + kixpower multi-agent orchestration, one-command import (preset + vision-bridge + guard plugins)",
  "license": "MIT",
  "author": "kix (olicesx)",
  "keywords": [
    "kixparadigm",
    "kixpower",
    "kix",
    "agent",
    "ai-agent",
    "deepseek-harness",
    "dsh",
    "agent-preset",
    "multi-agent",
    "coding-agent",
    "english"
  ],
  "bin": {
    "kixparadigm-en": "bin/kixparadigm-en.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "preset-classic-en/",
    "bridge/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/install-lib.js --quiet",
    "test:installer": "node --test scripts/install-lib.test.js",
    "test:consistency": "node scripts/check-consistency.cjs",
    "test:vision": "node --test bridge/test.js",
    "test": "npm run test:installer && node scripts/check-consistency.cjs && node --test bridge/test.js && cd preset-classic-en/plugins && node --test"
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "kixparadigm": {
    "variants": [
      { "id": "kixparadigm-classic-en", "dir": "preset-classic-en" }
    ],
    "bridgeDir": "bridge"
  },
  "repository": {
    "type": "git",
    "github": "olicesx/kixparadigm",
    "url": "git+https://github.com/olicesx/kixparadigm.git"
  },
  "bugs": {
    "url": "https://github.com/olicesx/kixparadigm/issues"
  },
  "homepage": "https://github.com/olicesx/kixparadigm#readme"
}
